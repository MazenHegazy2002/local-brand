{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "dist", "-p", "8083", "--no-clipboard"],
      "port": 8083,
      "cwd": "mobile"
    },
    {
      "name": "expo-mobile",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--port", "8082", "--clear"],
      "port": 8082,
      "url": "http://localhost:8082",
      "cwd": "mobile"
    }
  ]
}
