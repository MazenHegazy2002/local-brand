# ─── Platform Branding & Base URLs ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="Brandy"          # Display name shown in titles, emails, JSON-LD
NEXT_PUBLIC_APP_URL="https://brandyy.shop"  # Full canonical URL (no trailing slash)
NEXT_PUBLIC_SUPPORT_EMAIL="support@brandyy.shop"
NEXT_PUBLIC_CONTACT_PHONE="+20 10 20960757"
NEXT_PUBLIC_CONTACT_WHATSAPP="+20 10 20960757"

# ─── All Platform API Endpoints (Full REST API Directory) ─────────────────────
# 1. Public Read-Only Products Export (CORS Enabled for Claude Design & External Apps)
PUBLIC_PRODUCTS_API_URL="https://brandyy.shop/api/export/public-products"
NEXT_PUBLIC_PRODUCTS_EXPORT_URL="https://brandyy.shop/api/export/public-products"

# 2. Public Categories API
PUBLIC_CATEGORIES_API_URL="https://brandyy.shop/api/categories"
NEXT_PUBLIC_CATEGORIES_API_URL="https://brandyy.shop/api/categories"

# 3. Core Native & Web Application REST APIs
PRODUCTS_API_URL="https://brandyy.shop/api/products"
CART_API_URL="https://brandyy.shop/api/cart"
CHECKOUT_API_URL="https://brandyy.shop/api/checkout"
ORDERS_API_URL="https://brandyy.shop/api/orders"
SELLER_API_URL="https://brandyy.shop/api/seller/products"
AFFILIATE_API_URL="https://brandyy.shop/api/affiliate"

# 4. Payment Gateway Callback & Init Endpoints
PAYSKY_PAYMENT_URL="https://brandyy.shop/api/payment/paysky"
FAWRY_PAYMENT_URL="https://brandyy.shop/api/payment/fawry"
STRIPE_PAYMENT_URL="https://brandyy.shop/api/payment/intent"

# 5. Master REST API (Internal Server-to-Server Database Access)
MASTER_API_KEY="your-master-api-key"
MASTER_API_URL="https://brandyy.shop/api/v1/db"
NEXT_PUBLIC_MASTER_API_URL="https://brandyy.shop/api/v1/db"

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/localbrand?sslmode=require"

# ─── Authentication (NextAuth) ─────────────────────────────────────────────────
NEXTAUTH_SECRET="your-nextauth-secret" # Generate with: openssl rand -base64 32
NEXTAUTH_URL="https://brandyy.shop"

# ─── OAuth Providers ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Payments (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ─── Payments (PaySky PayForm Plus) ────────────────────────────────────────────
PAYSKY_MERCHANT_ID=""
PAYSKY_TERMINAL_ID=""
PAYSKY_MERCHANT_SECRET=""
PAYSKY_ENV="test"

# ─── Payments (PayMob — optional) ──────────────────────────────────────────────
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_IFRAME_ID=""
PAYMOB_HMAC_SECRET=""

# ─── Payments (Fawry — optional) ───────────────────────────────────────────────
FAWRY_MERCHANT_CODE=""
FAWRY_SECURITY_KEY=""
FAWRY_BASE_URL="https://www.atfawry.com"

# ─── Image Hosting ─────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Email Service (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY="re_xxx"

# ─── Redis (guest carts + rate limiting) ───────────────────────────────────────
REDIS_URL=""
REDIS_OFFLINE_QUEUE="false"
