{
  "expo": {
    "name": "Brandyy",
    "slug": "brandyy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "brandyy",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "shop.brandyy.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Brandyy uses the camera so you can take photos for your profile, reviews and product listings.",
        "NSPhotoLibraryUsageDescription": "Brandyy needs access to your photos so you can upload images for your profile, reviews and product listings.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "shop.brandyy.app",
      "versionCode": 1,
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES", "NOTIFICATIONS"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1e3b8a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Brandyy needs access to your photos so you can upload images for your profile, reviews and product listings.",
          "cameraPermission": "Brandyy uses the camera so you can take photos for your profile, reviews and product listings.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#faf8f5",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
